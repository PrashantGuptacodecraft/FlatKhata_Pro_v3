{
  "version": 2,
  "functions": {
    "index.js": {
      "includeFiles": "{frontend/**,backend/config/**}"
    },
    "api/index.js": {
      "includeFiles": "{frontend/**,backend/config/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/month-end",
      "schedule": "30 14 28-31 * *"
    }
  ]
}

# ============================================================
# FlatKhata Pro configuration
# Copy this file to .env and fill in the values you need.
# Leave a line empty or delete it to use the default.
# ============================================================

# ---- Server ----
PORT=3000
# 0.0.0.0 lets phones on the same Wi-Fi connect. Use 127.0.0.1 to allow this computer only.
HOST=0.0.0.0
# The address flatmates type into their phones. Use your computer's LAN IP, or your public domain.
# Example: http://192.168.1.20:3000   (Find it with `ipconfig` on Windows or `ip a` on Linux)
APP_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata

# ---- Database ----
# PostgreSQL database URL (e.g. Neon, AWS RDS, Supabase).
# Leave blank to use local JSON file in backend/data/db.json.
DATABASE_URL=

# ---- Security ----
# Leave blank to auto-generate a secret once and store it in backend/data/secret.key (recommended).
# If you set it, use 32+ random characters.
JWT_SECRET=
# How long a sign-in lasts before people must enter the password again.
TOKEN_TTL=15d

# ---- Month-end email ----
# Turn the automatic email on or off.
AUTO_REPORT_ENABLED=true
# When the check runs (cron syntax, in TIMEZONE). It sends only on the last day of the month.
# 0 20 * * *  = every day at 8:00 pm (Asia/Kolkata)
REPORT_CRON=0 20 * * *

# ---- Email delivery (SMTP) ----
# Leave SMTP_HOST empty to test without sending. Emails are then saved to backend/data/outbox.
# Gmail example: smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password (not your login password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FlatKhata Pro <your.address@gmail.com>"
